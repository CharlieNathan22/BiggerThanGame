---
// One card in a <Cards> list: a game on the homepage, a deck on the football
// page, or a mode on a deck's page. Title and text centred. With `href` the
// whole card is one link, named by its heading, that lifts, tilts with the
// pointer and glows gold on hover and focus (the tilt's few lines of script
// are in Page.astro). Without, it is a mode that isn't open yet: dimmed, not
// a link and not focusable, with "Coming soon" written out rather than shown by
// tint alone. Dimmed text still meets AA (tokens.css, and a test).
//
// A "Clear the squad" theme's card (`theme`) is the same card made compact for
// a grid of four: its name an h3 under the section's h2, in its own two tints,
// the edge in its own colours, how many legends, and the device's best.
import type { ThemeType } from "@bt/core";
import { t } from "../i18n";

interface Props {
  name: string;
  body: string;
  href?: string;
  /** The homepage's size: one big card per game. */
  large?: boolean;
  /** Takes a whole row of its list, the others sharing the rows below. */
  wide?: boolean;
  /**
   * A second link, a secondary button (Endless's leaderboards): on the card's
   * right on a wide screen, under its text below that. It sits above the
   * card's own link, never inside it, so each is its own target and its own
   * tab stop. Only on an open card.
   */
  extra?: { readonly href: string; readonly label: string };
  /**
   * A mode's own accent in place of the gold (Instagram Endless's pink): its
   * edge, glow, chevron, title on hover and best line, and an original glyph
   * over the title — a red heart that fills in on hover, never a brand's mark.
   */
  accent?: "instagram";
  /**
   * The device's best for the mode (`bt:best:legends:endless`), shown as
   * "Your best: n" by a few lines of script when storage has one. Without
   * storage, or with no best yet, the line stays hidden.
   */
  bestKey?: string;
  /**
   * A mode with a win target (Friendly's 20): the best reads "n/20", as the
   * game shows it. Carried in an inline style, which the dist leak scan sets
   * aside as markup, so the page holds no bare digits near a player's name.
   */
  bestOf?: number | undefined;
  /**
   * A "Clear the squad" theme: compact, its name an h3. `colours` are the
   * custom properties of its own colours (themes.ts), or none for the gold
   * card. Its best (`bestKey`) is the squad's JSON (best.ts), shown as
   * "Best 12/34" — `bestOf` being its questions — or "Cleared ✓".
   */
  theme?: { readonly id: string; readonly type: ThemeType; readonly colours: string | undefined };
}

const {
  name,
  body,
  href,
  large = false,
  wide = false,
  extra,
  accent,
  bestKey,
  bestOf,
  theme,
} = Astro.props;
const soon = href === undefined;
const Heading = theme === undefined ? "h2" : "h3";
---

<li
  class:list={[
    "card",
    accent,
    theme !== undefined && ["theme", theme.type, theme.id],
    // Two colours of its own: a theme with colours, or Instagram Endless (pink and gold).
    { coloured: theme?.colours !== undefined || accent === "instagram" },
    { large, soon, wide, open: !soon, split: !soon && extra !== undefined },
  ]}
  style={theme?.colours}
>
  <div class="text">
    {accent === "instagram" && (
      <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 20.5s-7.5-4.6-7.5-10.4A4.1 4.1 0 0 1 12 7.6a4.1 4.1 0 0 1 7.5 2.5c0 5.8-7.5 10.4-7.5 10.4z" />
      </svg>
    )}
    <Heading>
      {soon ? (
        name
      ) : (
        <a href={href}>
          <span class="name">{name}</span>
        </a>
      )}
    </Heading>
    <p class="body">{body}</p>
    {bestKey !== undefined && !soon && theme === undefined && (
      <p
        class="best"
        data-best-key={bestKey}
        data-template={t("mode.yourBest")}
        style={bestOf !== undefined ? `--best-of: ${bestOf}` : undefined}
        hidden
      />
    )}
    {bestKey !== undefined && !soon && theme !== undefined && (
      <p
        class="best"
        data-squad-key={bestKey}
        data-template={t("theme.best")}
        data-cleared={t("theme.cleared")}
        style={bestOf !== undefined ? `--best-of: ${bestOf}` : undefined}
        hidden
      />
    )}
  </div>
  {bestKey !== undefined && !soon && theme !== undefined && <script is:inline>
    // A squad's best from this device's storage, on this card only: "Best n/of",
    // or "Cleared" once it has been. Nothing at all when storage is blocked or
    // holds nothing readable: the line stays hidden. No digits here, so the
    // dist leak scan has nothing to weigh.
    (function () {
      try {
        const line = document.currentScript.parentElement.querySelector("[data-squad-key]");
        const raw = localStorage.getItem(line.getAttribute("data-squad-key"));
        if (raw === null) return;
        const run = JSON.parse(raw);
        if (!run || !Number.isInteger(run.best) || typeof run.cleared !== "boolean") return;
        if (run.cleared) {
          line.textContent = line.getAttribute("data-cleared");
        } else {
          if (!run.best) return;
          const of = line.style.getPropertyValue("--best-of").trim();
          line.textContent = line
            .getAttribute("data-template")
            .replace("{best}", String(run.best))
            .replace("{of}", of);
        }
        line.hidden = false;
      } catch {
        // Storage blocked, or something else under the key: no line.
      }
    })();
  </script>}
  {bestKey !== undefined && !soon && theme === undefined && <script is:inline>
    // "Your best: n" (or "n/target") from this device's storage, on this card only.
    // Nothing at all when storage is blocked or holds no best: the line stays
    // hidden. No digits here, so the dist leak scan has nothing to weigh.
    (function () {
      try {
        const line = document.currentScript.parentElement.querySelector("[data-best-key]");
        const raw = localStorage.getItem(line.getAttribute("data-best-key"));
        if (raw === null || !/^\d+$/.test(raw) || !Number(raw)) return;
        const best = String(Number(raw));
        const of = line.style.getPropertyValue("--best-of").trim();
        line.textContent = line
          .getAttribute("data-template")
          .replace("{best}", of === "" ? best : best + "/" + of);
        line.hidden = false;
      } catch {
        // Storage blocked: no line.
      }
    })();
  </script>}
  {!soon && extra !== undefined && (
    <a class="extra" href={extra.href}>
      {extra.label}
    </a>
  )}
  {soon ? <p class="badge">{t("mode.soon")}</p> : <span class="go" aria-hidden="true" />}
</li>

<style>
  /* A raised surface: a gentle gradient, light catching the top edge, a thin
       gold-tinted border, and two shadows under it (a close, crisp one and a
       wide, soft one), so it floats above the page. Title and text centred,
       with room either side for the chevron. */
  .card {
    position: relative;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--card-inner-gap);
    min-height: var(--card-min-h);
    padding: var(--card-pad);
    text-align: center;
    overflow: hidden;
    border: var(--border) solid var(--card-edge);
    border-radius: var(--card-radius);
    background: var(--card-surface);
    box-shadow: var(--card-shadow);
    /* The tilt, from the pointer (Page.astro), in degrees; flat without it. */
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    transform: perspective(var(--card-perspective)) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
    transition:
      border-color var(--dur-card) var(--ease-card),
      transform var(--dur-card) var(--ease-card),
      box-shadow var(--dur-card) var(--ease-card);
  }
  .card.large {
    padding: var(--card-pad-large);
  }
  .card.wide {
    grid-column: 1 / -1;
  }
  /* A card you can open lifts towards you on hover and keyboard focus, tilts
       with the pointer on a mouse (a fixed gentle lift without JS or on touch),
       its shadows grow deeper and softer in a gold glow, and a sheen crosses it
       once. Pressed, it settles down. With reduced motion only the colours and
       glow change, at once. */
  .card.open:hover,
  .card.open:has(a:focus-visible) {
    border-color: var(--card-edge-hover);
    box-shadow: var(--card-shadow-lifted);
    transform: perspective(var(--card-perspective)) rotateX(var(--tilt-x)) rotateY(var(--tilt-y))
      translateY(var(--card-lift-y)) scale(var(--card-lift-scale));
  }
  .card.open:active {
    border-color: var(--card-edge-hover);
    box-shadow: var(--card-shadow-pressed);
    transform: perspective(var(--card-perspective)) rotateX(var(--tilt-x)) rotateY(var(--tilt-y))
      translateY(var(--card-press-y)) scale(var(--card-press-scale));
  }
  .card.open::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--card-sheen);
    opacity: 0;
    transform: translateX(-100%);
  }
  .card.open:hover::before,
  .card.open:has(a:focus-visible)::before {
    animation: card-sheen var(--dur-card-sheen) var(--ease-card) both;
  }
  @keyframes card-sheen {
    from {
      opacity: 1;
      transform: translateX(-100%);
    }
    to {
      opacity: 1;
      transform: translateX(100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card.open:hover,
    .card.open:has(a:focus-visible),
    .card.open:active {
      transform: none;
    }
  }

  .card h2,
  .card h3 {
    margin: 0;
    padding: 0;
    border: 0;
    font-size: var(--fs-card-name);
    line-height: var(--lh-name);
    font-variation-settings: var(--fv-heading);
    color: var(--card-name);
  }
  .card.large h2 {
    font-size: var(--fs-card-name-large);
    font-variation-settings: var(--fv-display);
    letter-spacing: var(--tracking-display);
  }
  /* The title glows like the title bar's and footer's links, and turns gold
       with the larger glow on hover, focus and press. */
  .card a {
    color: inherit;
    text-decoration: none;
    text-shadow: var(--glow);
    transition:
      color var(--dur-card) var(--ease-card),
      text-shadow var(--dur-card) var(--ease-card);
  }
  .card.open:hover a,
  .card.open:active a,
  .card a:focus-visible {
    color: var(--gold);
    text-shadow: var(--glow-hover);
  }
  /* The whole card is the link's hit area: laid over everything in it (the
       title's box must stay unpositioned, so this spans the card, not the
       title). */
  .card a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }
  /* The title and text: laid out as the card's own children, except on a
       card with a second link, where they are one block beside it. */
  .text {
    display: contents;
  }
  .split .text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--card-inner-gap);
  }
  /* The second link sits above the card's, a secondary button (the game's
       outlined gold pill, from the same tokens): its own target and focus
       ring. Under the text: full width on a phone, its own width from 560px.
       From 900px, where the cards take the wide band, on the right — with an
       equal empty column on the left, so the text stays centred on the card
       like every other card's. */
  .card .extra {
    position: relative;
    z-index: 2;
    align-self: stretch;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--cta-h);
    margin-top: var(--card-inner-gap);
    padding: 0 var(--btn2-pad-x);
    border: var(--btn2-border) solid var(--btn2-edge);
    border-radius: var(--radius-pill);
    background: var(--btn2-bg);
    color: var(--btn2-text);
    font-size: var(--fs-btn2);
    font-variation-settings: var(--fv-cta);
    white-space: nowrap;
    box-shadow: var(--glow);
    transition:
      background-color var(--dur-hover),
      box-shadow var(--dur-hover),
      transform var(--dur-press);
  }
  .card .extra::after {
    content: none;
  }
  .card .extra:hover,
  .card .extra:active,
  .card .extra:focus-visible {
    background: var(--btn2-bg-hover);
    box-shadow: var(--glow-hover);
  }
  .card .extra:active {
    transform: scale(var(--press-scale));
  }
  .card .extra:focus-visible {
    outline: var(--focus-ring) solid var(--chalk);
    outline-offset: var(--focus-offset);
  }
  @media (min-width: 560px) {
    .card .extra {
      align-self: center;
    }
  }
  @media (min-width: 900px) {
    .card.split {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      column-gap: var(--card-split-gap);
    }
    .split .text {
      grid-column: 2;
    }
    .card .extra {
      grid-column: 3;
      justify-self: end;
      margin-top: 0;
    }
  }
  /* The focus ring goes round the card, not the heading inside it. */
  .card:has(:is(h2, h3) a:focus-visible) {
    outline: var(--focus-ring) solid var(--gold);
    outline-offset: var(--focus-offset);
  }
  @supports selector(:has(a)) {
    .card :is(h2, h3) a:focus-visible {
      outline: none;
    }
  }

  .card .body {
    margin: 0;
    /* A "\n" in the text is a line break. */
    white-space: pre-line;
    max-width: var(--card-body-w);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--card-body);
  }

  /* A chevron: this card goes somewhere. */
  .go {
    position: absolute;
    top: 50%;
    right: var(--card-chevron-inset);
    width: var(--card-chevron);
    height: var(--card-chevron);
    border-top: var(--card-chevron-stroke) solid var(--gold);
    border-right: var(--card-chevron-stroke) solid var(--gold);
    transform: translateY(-50%) rotate(45deg);
  }

  /* A mode with its own accent: the gold's places in pink (tokens.css), and,
       like a theme's card (`.coloured`, below), a fade of its two colours —
       pink into gold — along its top edge and across its name. The custom
       properties the card reads are resolved where they're declared, so each is
       set again here rather than only the colour underneath. */
  .card.instagram {
    --theme-1: var(--instagram);
    --theme-2: var(--instagram-gold);
    --theme-rgb: var(--instagram-rgb);
    --theme-text-1: var(--instagram);
    --theme-text-2: var(--instagram-gold);
    --gold: var(--instagram);
    --glow-rgb: var(--instagram-rgb);
    --card-edge: rgba(var(--instagram-rgb), 0.38);
    --card-edge-hover: var(--instagram);
    --card-best: var(--instagram);
    --glow: 0 0 var(--glow-blur) rgba(var(--instagram-rgb), var(--glow-opacity));
    --glow-hover: 0 0 var(--glow-hover-blur) rgba(var(--instagram-rgb), var(--glow-hover-opacity));
    --card-shadow-lifted:
      var(--card-top-light), 0 2px 4px rgba(0, 0, 0, 0.45), 0 22px 48px rgba(0, 0, 0, 0.45),
      0 0 26px rgba(var(--instagram-rgb), 0.32);
    --card-shadow-pressed:
      var(--card-top-light), 0 1px 2px rgba(0, 0, 0, 0.5), 0 8px 20px rgba(0, 0, 0, 0.4),
      0 0 20px rgba(var(--instagram-rgb), 0.28);
  }
  /* The heart: a red outline, filled in when the card is hovered or focused. */
  .glyph {
    width: var(--card-glyph);
    height: var(--card-glyph);
    fill: transparent;
    stroke: var(--heart);
    stroke-width: 1.8;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 6px rgba(var(--heart-rgb), 0.55));
    transition: fill var(--dur-card) var(--ease-card);
  }
  .card.open:hover .glyph,
  .card.open:has(a:focus-visible) .glyph {
    fill: var(--heart);
  }
  .card .best {
    margin: 0;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    font-variation-settings: var(--fv-caps);
    color: var(--card-best);
  }
  .card .best[hidden] {
    display: none;
  }

  /* A theme's card: compact, for a grid of four, every card in a row the same
     height (the grid stretches them). Over 44px tall whatever its text. */
  .card.theme {
    min-height: var(--theme-card-min-h);
    padding: var(--theme-card-pad);
    gap: calc(var(--card-inner-gap) / 2);
  }
  .card.theme h3 {
    font-size: var(--fs-theme-name);
    font-family: var(--font-display);
    font-variation-settings: normal;
    font-weight: var(--fw-legends);
    overflow-wrap: anywhere;
  }
  .card.theme .go {
    right: calc(var(--card-chevron-inset) / 2);
  }
  /* In its own colours: the edge a band of its two, and its glow on hover; its
     name in its two tints, which turn to its first tint lit on hover. The glow
     and shadows read --glow-rgb, so it is set here again (as for Instagram). */
  .card.coloured {
    --gold: var(--theme-text-1);
    --glow-rgb: var(--theme-rgb);
    --card-edge: rgba(var(--theme-rgb), 0.4);
    --card-edge-hover: var(--theme-text-1);
    --card-best: var(--theme-text-1);
    --glow: 0 0 var(--glow-blur) rgba(var(--theme-rgb), var(--glow-opacity));
    --glow-hover: 0 0 var(--glow-hover-blur) rgba(var(--theme-rgb), var(--glow-hover-opacity));
    --card-shadow-lifted:
      var(--card-top-light), 0 2px 4px rgba(0, 0, 0, 0.45), 0 22px 48px rgba(0, 0, 0, 0.45),
      0 0 26px rgba(var(--theme-rgb), 0.36);
    --card-shadow-pressed:
      var(--card-top-light), 0 1px 2px rgba(0, 0, 0, 0.5), 0 8px 20px rgba(0, 0, 0, 0.4),
      0 0 20px rgba(var(--theme-rgb), 0.3);
  }
  .card.coloured::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: var(--theme-edge-w);
    pointer-events: none;
    background: linear-gradient(90deg, var(--theme-1), var(--theme-2));
  }
  /* The name's glow is on the name, never the link: a filter on the link would
     make it the containing block for its ::after, and the card's whole-card
     hit area would shrink to the name. */
  .card.coloured .name {
    background: linear-gradient(90deg, var(--theme-text-1), var(--theme-text-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 6px rgba(var(--theme-rgb), 0.45));
    transition: filter var(--dur-card) var(--ease-card);
  }
  .card.coloured a {
    text-shadow: none;
  }
  .card.coloured.open:hover a,
  .card.coloured.open:active a,
  .card.coloured a:focus-visible {
    color: transparent;
    text-shadow: none;
  }
  .card.coloured.open:hover .name,
  .card.coloured.open:active .name,
  .card.coloured a:focus-visible .name {
    filter: drop-shadow(0 0 10px rgba(var(--theme-rgb), 0.85));
  }
  .card.coloured .go {
    border-color: var(--theme-text-1);
  }
  /* The decades: the 1990s on a VHS tape's scanlines, the 2000s in chrome, and the
     Classic Era (the 1980s and older) in an old photograph's sepia vignette. */
  .card.era-classic-era {
    background:
      radial-gradient(ellipse at center, transparent 50%, rgba(107, 68, 35, 0.32)),
      var(--card-surface);
  }
  .card.era-1990s {
    background:
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.035) 0 1px, transparent 1px 3px),
      var(--card-surface);
  }
  .card.era-2000s {
    background:
      linear-gradient(170deg, rgba(214, 226, 238, 0.12), transparent 45%), var(--card-surface);
  }
  .card.era-2010s::after {
    height: calc(var(--theme-edge-w) * 2);
  }

  /* Not open yet: the same raised card, dimmed and dashed, and still. */
  .soon {
    border-style: dashed;
    border-color: var(--card-soon-edge);
    background: var(--card-soon-bg);
    box-shadow: var(--card-shadow-soon);
  }
  .soon h2,
  .soon .body {
    color: var(--card-soon-text);
  }
  .card .badge {
    margin: 2px 0 0;
    padding: var(--badge-pad);
    border: var(--border) solid var(--card-soon-badge-edge);
    border-radius: var(--radius-pill);
    font-size: var(--fs-badge);
    line-height: var(--lh-body);
    font-variation-settings: var(--fv-caps);
    color: var(--card-soon-text);
  }
</style>
