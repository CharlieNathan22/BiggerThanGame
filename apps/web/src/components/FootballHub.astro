---
// The football hub's content: a short intro and the three modes. Shown at
// /football-higher-or-lower, and for now at /football-higher-or-lower/legends,
// which is canonical to the hub (DESIGN.md §17).
import { t } from "../i18n";
import { FRIENDLY_PATH } from "../lib/paths";
import Card from "./Card.astro";
import Cards from "./Cards.astro";
---

<h1>
  {t("hub.heading")} <em>{t("hub.headingEm")}</em>
</h1>
<p>{t("hub.intro")}</p>

<Cards label={t("hub.modes")} stack>
  <Card name={t("mode.friendly.name")} body={t("mode.friendly.body")} href={FRIENDLY_PATH} />
  <Card name={t("mode.endless.name")} body={t("mode.endless.body")} />
  <Card name={t("mode.ranked.name")} body={t("mode.ranked.body")} />
</Cards>
