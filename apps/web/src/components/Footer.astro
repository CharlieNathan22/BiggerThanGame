---
// The prototype's footer line, carrying site links instead of the prototype notice.
const links = [
  { href: "/about", label: "About" },
  { href: "/credits", label: "Credits" },
  { href: "/about#how-to-play", label: "How to play" },
];
---

<footer class="foot">
  <nav aria-label="Site">
    {links.map((link, i) => (
      <>
        {i > 0 && <span aria-hidden="true"> · </span>}
        <a href={link.href}>{link.label}</a>
      </>
    ))}
  </nav>
</footer>

<style>
  .foot {
    flex: none;
    padding: 6px 18px 8px;
    font-size: var(--fs-foot);
    color: var(--faint);
    text-align: center;
    font-variation-settings: var(--fv-meta);
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    color: var(--dim);
    text-decoration: underline;
  }
</style>
