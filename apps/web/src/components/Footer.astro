---
// The prototype's footer line, carrying site links instead of the prototype notice.
import { t } from "../i18n";

const links = [
  { href: "/about", label: t("footer.about") },
  { href: "/credits", label: t("footer.credits") },
  { href: "/about#how-to-play", label: t("footer.howToPlay") },
];
---

<footer class="foot">
  <nav aria-label={t("footer.nav")}>
    {links.map((link, i) => (
      <>
        {i > 0 && <span aria-hidden="true"> · </span>}
        <a href={link.href}>{link.label}</a>
      </>
    ))}
  </nav>
</footer>

<style>
  .foot {
    flex: none;
    padding: 6px 18px 8px;
    font-size: var(--fs-foot);
    color: var(--faint);
    text-align: center;
    font-variation-settings: var(--fv-meta);
  }
  /* The links read at --dim (4.5:1 and up); only the separators stay faint. */
  a {
    position: relative;
    color: var(--dim);
    text-decoration: none;
  }
  a:hover {
    color: var(--chalk);
    text-decoration: underline;
  }
  /* A 44px touch target around small text, without moving the line. */
  a::after {
    content: "";
    position: absolute;
    left: -6px;
    right: -6px;
    top: 50%;
    height: var(--target-min);
    transform: translateY(-50%);
  }
</style>
