---
// The prototype's footer line, carrying site links instead of the prototype
// notice, and the two general feedback forms. About and How to play are in the
// title bar's navigation, so they aren't repeated here: that keeps the footer
// to one row on a 360px phone, and the game its height. Links step out as the
// row narrows — Leaderboards below 440px (on a phone it's in the title bar's
// Menu and on the Legends page's Endless card), GitHub below 360px — so
// Credits · Privacy and the forms still fit one row at 320px; with them the
// row wraps and the game's Start button goes under the footer. Twitch Mode
// steps out first, below 600px: it's one tap from the Menu's Multiplayer.
import { GITHUB_URL } from "../config";
import { t } from "../i18n";
import { currentPage } from "../lib/nav";
import {
  CREDITS_PATH,
  FRIENDLY_PATH,
  LEADERBOARD_PATH,
  PRIVACY_PATH,
  TWITCH_PATH,
  servedPath,
} from "../lib/paths";

const path = servedPath(Astro.url.pathname);

// `rel` only where the link leaves the site. `roomy`: only from 360px wide;
// `wider`: only from 440px; `widest`: only from 600px.
const links = [
  { href: LEADERBOARD_PATH, label: t("footer.leaderboards"), wider: true },
  { href: TWITCH_PATH, label: t("footer.twitch"), widest: true },
  { href: CREDITS_PATH, label: t("footer.credits") },
  { href: PRIVACY_PATH, label: t("footer.privacy") },
  { href: GITHUB_URL, label: t("footer.github"), rel: "noopener", roomy: true },
];

// The forms live in the game island on the game page. There, the island opens
// them directly from these links (`data-feedback`); from any other page the
// link goes to the game page, whose hash opens the form on load.
const feedback = [
  { kind: "suggest", label: t("footer.suggest") },
  { kind: "problem", label: t("footer.problem") },
];
---

<footer class="foot">
  <nav aria-label={t("footer.nav")}>
    {links.map((link, i) => (
      <span class:list={{ roomy: link.roomy, wider: link.wider, widest: link.widest }}>
        {i > 0 && (
          <span class="sep" aria-hidden="true">
            {" "}
            ·{" "}
          </span>
        )}
        <a href={link.href} rel={link.rel} aria-current={currentPage(link.href, path)}>
          {link.label}
        </a>
      </span>
    ))}
  </nav>
  <nav aria-label={t("footer.feedbackNav")}>
    {feedback.map((link, i) => (
      <>
        {i > 0 && <span aria-hidden="true"> · </span>}
        <a href={`${FRIENDLY_PATH}#${link.kind}`} data-feedback={link.kind}>
          {link.label}
        </a>
      </>
    ))}
  </nav>
</footer>

<style>
  /* Two groups on one line; on a narrow screen the second wraps below, far
     enough down that the two rows' 44px hit areas don't overlap. */
  .foot {
    /* Above the page, so its shadow falls on it. */
    position: relative;
    flex: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: var(--foot-group-gap);
    row-gap: var(--foot-row-gap);
    padding: var(--foot-pad-y) 18px calc(var(--foot-pad-y) + 2px);
    /* The title bar's raised surface, facing up. */
    background: var(--foot-bg);
    border-top: var(--border) solid var(--chrome-rule);
    box-shadow: var(--foot-shadow);
    font-size: var(--fs-foot);
    color: var(--faint);
    text-align: center;
    font-variation-settings: var(--fv-foot);
    /* Chrome, not content: nothing here selects, and a tap doesn't flash. */
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  nav {
    white-space: nowrap;
  }
  /* Too narrow for every link on one row: the least needed one steps out. */
  @media (max-width: 359px) {
    .roomy {
      display: none;
    }
  }
  /* The first link out, Twitch Mode. */
  @media (max-width: 599px) {
    .widest {
      display: none;
    }
  }
  /* Then Leaderboards: the first link left (Credits) loses its separator with it. */
  @media (max-width: 439px) {
    .wider,
    .widest + span > .sep {
      display: none;
    }
  }
  /* The links read at --dim (4.5:1 and up); only the separators stay faint.
     As in the title bar: no underlines, and hover, press and keyboard focus
     turn a link gold with a stronger glow. */
  a {
    position: relative;
    color: var(--dim);
    text-decoration: none;
    text-shadow: var(--glow);
    transition:
      color var(--dur-hover),
      text-shadow var(--dur-hover);
  }
  a:hover,
  a:active,
  a:focus-visible {
    color: var(--gold);
    text-shadow: var(--glow-strong);
  }
  /* A 44px touch target around small text, without moving the line. */
  a::after {
    content: "";
    position: absolute;
    left: -6px;
    right: -6px;
    top: 50%;
    height: var(--target-min);
    transform: translateY(-50%);
  }
</style>
