---
// 1v1's icon: two players facing each other, our own drawing, as Twitch
// Mode's is (ChatVsYouIcon). No club's, league's or platform's marks
// (DESIGN.md §17): one player in the site's gold, the other in the match
// mint, the two colours a match is scored in. Decoration only; the card it
// sits on is named by its heading. Put first on its card (`order`).
---

<svg class="facing" viewBox="0 0 64 32" aria-hidden="true" focusable="false">
  <!-- One player, head and shoulders, on the left. -->
  <circle class="you" cx="14" cy="10" r="5" />
  <path class="you" d="M4 28c0-6 4.5-10 10-10s10 4 10 10" />
  <!-- Facing them, the other. -->
  <circle class="them" cx="50" cy="10" r="5" />
  <path class="them" d="M40 28c0-6 4.5-10 10-10s10 4 10 10" />
  <!-- Between them: head to head. -->
  <path class="versus" d="M29 11l3 5-3 5M35 11l-3 5 3 5" />
</svg>

<style>
  .facing {
    order: -1;
    width: var(--duel-icon-w);
    height: auto;
    margin: 0 auto var(--card-inner-gap);
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }
  .you {
    stroke: var(--duel-you);
    filter: drop-shadow(0 0 4px rgba(var(--glow-rgb), 0.6));
  }
  .them {
    stroke: var(--duel-them);
  }
  .versus {
    stroke: var(--dim);
  }
</style>
