---
import Page from "../layouts/Page.astro";
---

<Page
  title="Page Not Found | Bigger Than Game"
  description="That page doesn't exist. Head back to the homepage to play higher or lower with football legends."
  canonical={false}
>
  <div class="missing">
    <div class="final num" aria-hidden="true">
      404
    </div>
    <h1 class="sr">Page not found</h1>
    <p>That page doesn't exist.</p>
    <a class="cta" href="/">
      Go to the homepage
    </a>
  </div>
</Page>

<style>
  /* The game-over panel's big number. */
  .missing {
    padding-top: 10vh;
    text-align: center;
  }
  .final {
    font-size: var(--fs-final);
    line-height: var(--lh-final);
    color: var(--gold);
  }
</style>
