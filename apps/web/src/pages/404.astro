---
import Page from "../layouts/Page.astro";
---

<Page title="Not found — Bigger Than Game" description="That page doesn't exist." canonical={false}>
  <div class="missing">
    <div class="final num" aria-hidden="true">
      404
    </div>
    <h1 class="sr">Page not found</h1>
    <p>That page doesn't exist.</p>
    <a class="cta" href="/">
      Back to the game
    </a>
  </div>
</Page>

<style>
  /* The game-over panel's big number. */
  .missing {
    padding-top: 10vh;
    text-align: center;
  }
  .final {
    font-size: var(--fs-final);
    line-height: var(--lh-final);
    color: var(--gold);
  }
</style>
