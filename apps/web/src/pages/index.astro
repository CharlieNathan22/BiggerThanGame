---
// The Bigger Than homepage: the brand, the idea, and a card per game
// (DESIGN.md §17). Static, no JS.
import Page from "../layouts/Page.astro";
import Card from "../components/Card.astro";
import Cards from "../components/Cards.astro";
import { t } from "../i18n";
import { FOOTBALL_PATH } from "../lib/paths";
---

<Page title={t("home.title")} description={t("home.description")}>
  <h1>
    {t("brand.bigger")}
    <em>{t("brand.than")}</em>
  </h1>
  <p class="tagline">{t("home.tagline")}</p>

  <Cards label={t("home.games")}>
    <Card
      large
      name={t("home.football.name")}
      body={t("home.football.body")}
      href={FOOTBALL_PATH}
    />
  </Cards>
</Page>

<style>
  .tagline {
    font-size: var(--fs-tagline);
    color: var(--chalk);
  }
</style>
