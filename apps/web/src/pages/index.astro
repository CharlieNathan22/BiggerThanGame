---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import Game from "../components/game/Game.svelte";
import { t } from "../i18n";
---

<Base
  title="Bigger Than Game — Football Legends Higher or Lower"
  description="The football higher or lower game where the stat keeps changing. Two legends, one stat: is the hidden number higher or lower? Free, no sign-up."
  game
>
  <!-- client:load, not client:visible: the first tap must not wait (ARCHITECTURE.md §14). -->
  <Game client:load />
  <noscript>
    <p class="noscript">{t("start.noscript")}</p>
  </noscript>
  <Footer />
</Base>

<style>
  /* The island's wrapper element must not break the page's flex column. */
  :global(astro-island) {
    display: contents;
  }
  .noscript {
    padding: 8px 18px;
    text-align: center;
    font-size: var(--fs-body);
    color: var(--dim);
  }
</style>
