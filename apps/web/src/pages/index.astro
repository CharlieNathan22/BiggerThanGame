---
import Base from '../layouts/Base.astro';
import TitleBar from '../components/TitleBar.astro';
---

<Base title="Bigger Than Game — Football Legends">
  <div class="shell">
    <TitleBar />
    <main>
      <p>Phase 0 — scaffolding works.</p>
