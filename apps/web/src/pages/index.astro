---
// The Bigger Than homepage: the brand, the idea, and a card per game —
// Football Legends today, straight to its deck (DESIGN.md §17). Static, no JS.
import Page from "../layouts/Page.astro";
import Card from "../components/Card.astro";
import Cards from "../components/Cards.astro";
import { t } from "../i18n";
import { LEGENDS_PATH } from "../lib/paths";
---

<Page title={t("home.title")} description={t("home.description")}>
  <h1 class="brand glow">
    {t("brand.bigger")} <em>{t("brand.than")}</em> {t("brand.game")}
  </h1>
  <p class="tagline">{t("home.tagline")}</p>

  <Cards label={t("home.games")} roomy>
    <Card large name={t("home.legends.name")} body={t("home.legends.body")} href={LEGENDS_PATH} />
    <Card large name={t("home.managers.name")} body={t("home.managers.body")} />
  </Cards>
</Page>

<style>
  .tagline {
    font-size: var(--fs-tagline);
    color: var(--chalk);
  }
</style>
