---
// The game: Endless on the Legends deck. The same fixed-height, no-scroll
// screen and island as Friendly (Base's `game`), driven by the mode. Indexed
// like Friendly's, with the site's default preview image.
import Base from "../../../layouts/Base.astro";
import Footer from "../../../components/Footer.astro";
import Game from "../../../components/game/Game.svelte";
import { t } from "../../../i18n";
import { ENDLESS_PATH } from "../../../lib/paths";
import { breadcrumbLd, breadcrumbTrail, gameLd } from "../../../lib/seo";
---

<Base
  title={t("endless.title")}
  description={t("endless.description")}
  game
  structuredData={[breadcrumbLd(breadcrumbTrail(ENDLESS_PATH)), gameLd()]}
>
  <!-- client:load, not client:visible: the first tap must not wait (ARCHITECTURE.md §14). -->
  <Game client:load deck="legends" mode="endless" path={ENDLESS_PATH} />
  <noscript>
    <p class="noscript">{t("start.noscript")}</p>
  </noscript>
  <Footer />
</Base>

<style>
  /* The island's wrapper element must not break the page's flex column. */
  :global(astro-island) {
    display: contents;
  }
  .noscript {
    padding: 8px 18px;
    text-align: center;
    font-size: var(--fs-body);
    color: var(--dim);
  }
</style>
