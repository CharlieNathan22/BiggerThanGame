---
// The Endless leaderboard (DESIGN.md §13, §17): today's, this week's and this
// month's personal bests, and this device's own best runs. A static page; the
// island fetches the boards (GET /api/board/endless/:period), which are
// served from a cache up to a minute old. Framed plainly as personal bests:
// every run is different, and the longest streak wins. No player's figure anywhere.
import Page from "../../../../layouts/Page.astro";
import Breadcrumb from "../../../../components/Breadcrumb.astro";
import BoardSwitch from "../../../../components/BoardSwitch.astro";
import Leaderboard from "../../../../components/Leaderboard.svelte";
import { t } from "../../../../i18n";
import { ENDLESS_PATH, ENDLESS_LEADERBOARD_PATH } from "../../../../lib/paths";
import { breadcrumbLd, breadcrumbTrail } from "../../../../lib/seo";

const trail = breadcrumbTrail(ENDLESS_LEADERBOARD_PATH);
---

<Page
  title={t("leaderboard.title")}
  description={t("leaderboard.description")}
  legendsLights
  structuredData={[breadcrumbLd(trail)]}
>
  <Breadcrumb items={trail.slice(1).map((crumb) => ({ label: crumb.name, href: crumb.path }))} />
  <!-- The Legends page's heading: two short lines, centred, in the gold glow. -->
  <h1 class="twoline glow">
    {t("leaderboard.headingMode")}
    <br />
    <em>{t("leaderboard.headingBoard")}</em>
  </h1>
  <BoardSwitch current="endless" />
  <p class="centred">{t("leaderboard.framing")}</p>
  <p class="next">
    <a class="cta" href={ENDLESS_PATH}>
      {t("leaderboard.play")}
    </a>
  </p>

  <Leaderboard client:load mode="endless" />
  <noscript>
    <p class="centred">{t("leaderboard.noscript")}</p>
  </noscript>

  <p class="next">
    <a class="cta" href={ENDLESS_PATH}>
      {t("leaderboard.play")}
    </a>
  </p>
</Page>

<style>
  /* As the Legends page's "Play Friendly": the site's call to action, centred. */
  .next {
    text-align: center;
  }
</style>
