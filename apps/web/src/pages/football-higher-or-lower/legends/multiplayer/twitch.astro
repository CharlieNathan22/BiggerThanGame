---
// Twitch Mode ("Chat vs You", DESIGN.md §3): a streamer plays a match against
// their own chat, read in the browser from Twitch's public chat. The game's
// fixed-height, no-scroll screen and island (Base's `game`), with the setup in
// the start panel's place; its own title, description, canonical and
// structured data (a breadcrumb under Multiplayer, and a MultiPlayer
// VideoGame), and the site's default preview. The picker's themes are the
// same list as the squad pages', so a new theme appears here on its own.
import Base from "../../../../layouts/Base.astro";
import Footer from "../../../../components/Footer.astro";
import Game from "../../../../components/game/Game.svelte";
import { t } from "../../../../i18n";
import { TWITCH_PATH } from "../../../../lib/paths";
import { breadcrumbLd, breadcrumbTrail, twitchGameLd } from "../../../../lib/seo";
import { loadThemes, themeColours } from "../../../../lib/themes";

const themes = loadThemes().map(({ id, type, name, slug, players }) => ({
  id,
  type,
  name,
  slug,
  players,
}));
/** Each theme's colours as its card's custom properties; a theme without its own has none. */
const colours = Object.fromEntries(
  themes.flatMap((theme) => {
    const style = themeColours(theme);
    return style === undefined ? [] : [[theme.id, style]];
  }),
);
---

<Base
  title={t("twitch.title")}
  description={t("twitch.description")}
  game
  structuredData={[breadcrumbLd(breadcrumbTrail(TWITCH_PATH)), twitchGameLd()]}
>
  <!-- client:load, not client:visible: the first tap must not wait (ARCHITECTURE.md §14). -->
  <Game
    client:load
    deck="legends"
    mode="stream"
    path={TWITCH_PATH}
    streamThemes={themes}
    streamColours={colours}
  />
  <noscript>
    <p class="noscript">{t("start.noscript")}</p>
  </noscript>
  <Footer />
</Base>

<style>
  /* The island's wrapper element must not break the page's flex column. */
  :global(astro-island) {
    display: contents;
  }
  .noscript {
    padding: 8px 18px;
    text-align: center;
    font-size: var(--fs-body);
    color: var(--dim);
  }
</style>
