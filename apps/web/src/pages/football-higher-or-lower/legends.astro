---
// The Legends deck: its intro and the three modes (DESIGN.md §17). Static, no
// JS. Where "Play" goes.
import Page from "../../layouts/Page.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Card from "../../components/Card.astro";
import Cards from "../../components/Cards.astro";
import { t } from "../../i18n";
import { FOOTBALL_PATH, FRIENDLY_PATH, LEGENDS_PATH } from "../../lib/paths";
---

<Page title={t("legends.title")} description={t("legends.description")} legendsLights>
  <Breadcrumb
    items={[
      { label: t("breadcrumb.football"), href: FOOTBALL_PATH },
      { label: t("breadcrumb.legends"), href: LEGENDS_PATH },
    ]}
  />
  <!-- One heading, on two lines, each kept whole, centred, in the gold glow. -->
  <h1 class="twoline glow">
    {t("legends.heading")}
    <br />
    <em>{t("legends.headingHigher")}</em> {t("legends.headingOr")}{" "}
    <em>{t("legends.headingLower")}</em>
  </h1>
  <p class="centred">{t("legends.intro")}</p>

  <Cards label={t("legends.modes")} stack>
    <Card name={t("mode.friendly.name")} body={t("mode.friendly.body")} href={FRIENDLY_PATH} wide />
    <Card name={t("mode.endless.name")} body={t("mode.endless.body")} />
    <Card name={t("mode.ranked.name")} body={t("mode.ranked.body")} />
  </Cards>
</Page>
