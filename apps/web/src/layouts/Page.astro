---
// Static pages: title bar, a column of text, footer. Scrolls normally.
import "../styles/prose.css";
import Base from "./Base.astro";
import TitleBar from "../components/TitleBar.svelte";
import Footer from "../components/Footer.astro";
import { HOME_PATH, isLegendsPath, servedPath } from "../lib/paths";

interface Props {
  title: string;
  description: string;
  canonical?: string | false;
}

const { title, description, canonical } = Astro.props;
const path = servedPath(Astro.url.pathname);
---

<Base title={title} description={description} {...(canonical !== undefined ? { canonical } : {})}>
  <TitleBar home={path !== HOME_PATH} legends={isLegendsPath(path)} />
  <main class="prose">
    <slot />
  </main>
  <Footer />
</Base>
