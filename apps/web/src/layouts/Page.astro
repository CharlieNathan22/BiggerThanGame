---
// Static pages: title bar, a column of text, footer. Scrolls normally.
import "../styles/prose.css";
import Base from "./Base.astro";
import TitleBar from "../components/TitleBar.svelte";
import Footer from "../components/Footer.astro";
import { isLegendsPath, servedPath } from "../lib/paths";

interface Props {
  title: string;
  description: string;
  canonical?: string | false;
  /** The Legends page's extra light over the background (Base.astro). */
  legendsLights?: boolean;
  /**
   * Text that selects as usual: Credits' list. Elsewhere nothing on the page
   * selects; a page can still hold back parts of a selectable one.
   */
  selectable?: boolean;
  /** The title bar stays at the top as the page scrolls: the long pages, About and Credits. */
  stickyBar?: boolean;
}

const {
  title,
  description,
  canonical,
  legendsLights = false,
  selectable = false,
  stickyBar = false,
} = Astro.props;
const path = servedPath(Astro.url.pathname);
---

<Base
  title={title}
  description={description}
  {legendsLights}
  {...(canonical !== undefined ? { canonical } : {})}
>
  <TitleBar legends={isLegendsPath(path)} current={path} sticky={stickyBar} />
  <main class:list={["prose", { fixed: !selectable }]}>
    <slot />
  </main>
  <Footer />
  <!--
    The title bar's menu, as the game page's island handles it: Esc closes it,
    returning focus to "Menu" if it was inside, and a click outside closes it.
    Inline and framework-free; with JS off the menu still opens and closes.
  -->
  <script is:inline>
    (() => {
      const menu = document.querySelector("[data-menu]");
      if (!menu) return;
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !menu.open) return;
        const inside = menu.contains(document.activeElement);
        menu.open = false;
        if (inside) menu.querySelector("summary").focus();
      });
      document.addEventListener("click", (event) => {
        if (menu.open && event.target instanceof Node && !menu.contains(event.target)) {
          menu.open = false;
        }
      });
    })();
  </script>
</Base>

<style>
  /* Nothing selects on a long press or a double-click, and a tap doesn't flash. */
  .fixed {
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
</style>
