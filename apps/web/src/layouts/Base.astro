---
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/base.css";
import archivoLatin from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import cinzelLatin from "@fontsource/cinzel/files/cinzel-latin-900-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  /** The game page: a fixed-height screen with no scrolling. `/` only. */
  game?: boolean;
  /** Off for pages that shouldn't be indexed under their own URL, like the 404. */
  canonical?: boolean;
}

const { title, description, game = false, canonical = true } = Astro.props;

// Pages build to `about.html` and are served at `/about` (astro.config.mjs).
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, "") || "/";
const canonicalUrl = new URL(path, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonicalUrl} />}
    <!-- The title bar's --ink. A meta tag can't read a custom property. -->
    <meta name="theme-color" content="#06121a" />
    <!-- The title bar is on every page, so its two Latin faces are always needed. -->
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={cinzelLatin} as="font" type="font/woff2" crossorigin />
  </head>
  <body class:list={{ game }}>
    <div class="frame">
      <slot />
    </div>
  </body>
</html>
