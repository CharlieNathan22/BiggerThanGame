{
  "name": "biggerthan",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter @bt/deck build --no-sim && pnpm --filter web build",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/deck && tsc -p worker && tsc -p tsconfig.json",
    "lint": "eslint .",
    "simulate": "pnpm --filter @bt/deck build",
    "images:sync": "pnpm --filter @bt/deck exec tsx src/sync-cli.ts",
    "deploy": "pnpm build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  }
}
