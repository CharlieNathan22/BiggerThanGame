{
  "name": "biggerthan",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "pnpm --filter @bt/deck build --no-sim && pnpm db:migrate:local && pnpm run \"/^dev:(worker|web)$/\"",
    "dev:worker": "wrangler dev --port 8787 --test-scheduled",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter @bt/deck build --no-sim && pnpm db:migrate:local && wrangler dev --test-scheduled",
    "build": "pnpm --filter @bt/deck build --no-sim && pnpm --filter web build && pnpm scan:dist && pnpm check:site",
    "build:prod": "pnpm --filter @bt/deck build --no-sim --require-private && pnpm --filter web build && pnpm scan:dist && pnpm check:site",
    "scan:dist": "pnpm --filter @bt/deck exec tsx src/scan-dist-cli.ts",
    "check:site": "tsx scripts/check-site.ts",
    "site:images": "tsx scripts/site-images.ts",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/deck && tsc -p worker && tsc -p worker/tsconfig.test.json && tsc -p tsconfig.json && tsc -p scripts && pnpm --filter web typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "simulate": "pnpm --filter @bt/deck build",
    "images:sync": "pnpm --filter @bt/deck exec tsx src/sync-cli.ts",
    "deck:import": "pnpm --filter @bt/deck exec tsx src/import-cli.ts",
    "stats": "tsx scripts/stats.ts",
    "deploy": "pnpm build:prod && wrangler deploy",
    "blocklist:build": "tsx scripts/blocklist.ts",
    "db:migrate:local": "tsx scripts/db.ts migrate:local",
    "db:migrate:remote": "tsx scripts/db.ts migrate:remote",
    "db:seed:local": "tsx scripts/db.ts seed:local",
    "db:reset:local": "tsx scripts/db.ts reset:local",
    "db:owner": "tsx scripts/db.ts owner",
    "load:local": "tsx scripts/load-test.ts"
  },
  "devDependencies": {
    "@bt/core": "workspace:*",
    "@bt/deck": "workspace:*",
    "@cloudflare/workers-types": "^5.20260915.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-svelte": "^3.23.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-svelte": "^4.1.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  }
}
