{
  "name": "biggerthan",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "pnpm --filter @bt/deck build --no-sim && pnpm run \"/^dev:(worker|web)$/\"",
    "dev:worker": "wrangler dev --port 8787",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter @bt/deck build --no-sim && wrangler dev",
    "build": "pnpm --filter @bt/deck build --no-sim && pnpm --filter web build",
    "build:prod": "pnpm --filter @bt/deck build --no-sim --require-private && pnpm --filter web build",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/deck && tsc -p worker && tsc -p worker/tsconfig.test.json && tsc -p tsconfig.json && pnpm --filter web typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "simulate": "pnpm --filter @bt/deck build",
    "images:sync": "pnpm --filter @bt/deck exec tsx src/sync-cli.ts",
    "deck:import": "pnpm --filter @bt/deck exec tsx src/import-cli.ts",
    "deploy": "pnpm build:prod && wrangler deploy"
  },
  "devDependencies": {
    "@bt/core": "workspace:*",
    "@bt/deck": "workspace:*",
    "@cloudflare/workers-types": "^5.20260915.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-svelte": "^4.1.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  }
}
